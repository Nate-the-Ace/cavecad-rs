diff --git a/cave-survey/scripts/CaveSurvey/Core/CsShapeFont.js b/cave-survey/scripts/CaveSurvey/Core/CsShapeFont.js
new file mode 100644
index 0000000000..1a7ed68f39
--- /dev/null
+++ b/cave-survey/scripts/CaveSurvey/Core/CsShapeFont.js
@@ -0,0 +1,348 @@
+// CsShapeFont.js -- named shapes for shaped linetypes: the pure half.
+//
+// A shaped linetype draws a NAMED GLYPH at the end of a pattern segment
+// (CsLinetype segment with shape:true; text = glyph name, style =
+// "<font>.shx"). The engine finds the glyph in a CXF font file: a glyph
+// whose [XXXX] header carries a name longer than one character goes to
+// the font's shape map (RFont.cpp), and the style's ".shx" suffix tells
+// RLinetypePattern::updateShapes to look there. So a "shape font" is just
+// a CXF file we write ourselves, in unit coordinates, drawn y-up.
+//
+// A glyph is { name, paths:[ { closed, pts:[ {x, y, b} ] } ] } where b is
+// the DXF-style bulge of the segment that STARTS at that vertex. Every
+// drawn entity (line, arc, circle, polyline) reduces to such a path, so
+// the file only ever needs PL/PLC records and no arc-sign conventions.
+//
+// No engine calls here: this file runs under node too (tests/js_unit.js).
+
+var CsShapeFont = {};
+
+/** The font file (and so the style) our shapes live in. */
+CsShapeFont.FONT = "CaveShapes";
+
+/** Shape names: letters, digits, underscore; two or more characters. */
+CsShapeFont.NAME_RE = /^[A-Za-z][A-Za-z0-9_]+$/;
+
+/** First private-use code point handed to a glyph; the code is only an
+ *  index, the NAME is what a linetype refers to. */
+CsShapeFont.CODE_BASE = 0xE000;
+
+CsShapeFont.r6 = function(v) {
+    var r = Math.round(Number(v) * 1e6) / 1e6;
+    return r === 0 ? 0 : r;
+};
+
+CsShapeFont.vertex = function(x, y, b) {
+    return { x: CsShapeFont.r6(x), y: CsShapeFont.r6(y),
+             b: CsShapeFont.r6(b || 0) };
+};
+
+CsShapeFont.path = function(points, closed) {
+    var pts = [];
+    for (var i = 0; i < points.length; i++) {
+        var p = points[i];
+        pts.push(CsShapeFont.vertex(p.x !== undefined ? p.x : p[0],
+                                    p.y !== undefined ? p.y : p[1],
+                                    p.b !== undefined ? p.b : (p[2] || 0)));
+    }
+    return { closed: !!closed, pts: pts };
+};
+
+/** A line as a two-vertex path. */
+CsShapeFont.linePath = function(x1, y1, x2, y2) {
+    return CsShapeFont.path([[x1, y1, 0], [x2, y2, 0]], false);
+};
+
+/** An arc (degrees, counter-clockwise unless reversed) as a path. */
+CsShapeFont.arcPath = function(cx, cy, r, a1, a2, reversed) {
+    var s = a1 * Math.PI / 180;
+    var e = a2 * Math.PI / 180;
+    var TAU = 2 * Math.PI;
+    var sweep = reversed ? -(((s - e) % TAU) + TAU) % TAU
+                         : (((e - s) % TAU) + TAU) % TAU;
+    if (Math.abs(sweep) < 1e-9) {
+        sweep = reversed ? -2 * Math.PI : 2 * Math.PI;
+    }
+    var bulge = Math.tan(sweep / 4);
+    return CsShapeFont.path([
+        [cx + r * Math.cos(s), cy + r * Math.sin(s), bulge],
+        [cx + r * Math.cos(s + sweep), cy + r * Math.sin(s + sweep), 0]
+    ], false);
+};
+
+/** A full circle: two half-turn bulges, closed. */
+CsShapeFont.circlePath = function(cx, cy, r) {
+    return CsShapeFont.path([[cx + r, cy, 1], [cx - r, cy, 1]], true);
+};
+
+CsShapeFont.glyph = function(name, paths) {
+    return { name: name, paths: paths || [] };
+};
+
+CsShapeFont.validName = function(name) {
+    return CsShapeFont.NAME_RE.test(String(name));
+};
+
+/** Problems with a glyph, as strings; empty when it is writable. */
+CsShapeFont.validate = function(g) {
+    var out = [];
+    if (!CsShapeFont.validName(g.name)) {
+        out.push("Shape name needs 2+ letters, digits or _ and must start with a letter.");
+    }
+    if (!g.paths || g.paths.length === 0) {
+        out.push("Shape has no geometry.");
+    } else {
+        for (var i = 0; i < g.paths.length; i++) {
+            if (g.paths[i].pts.length < 2) {
+                out.push("Shape path " + (i + 1) + " needs two points.");
+            }
+        }
+    }
+    return out;
+};
+
+/** Bounding box of a glyph's vertices (bulges ignored: a close bound). */
+CsShapeFont.bounds = function(g) {
+    var minx = Infinity, miny = Infinity, maxx = -Infinity, maxy = -Infinity;
+    for (var i = 0; i < g.paths.length; i++) {
+        for (var k = 0; k < g.paths[i].pts.length; k++) {
+            var p = g.paths[i].pts[k];
+            minx = Math.min(minx, p.x);
+            miny = Math.min(miny, p.y);
+            maxx = Math.max(maxx, p.x);
+            maxy = Math.max(maxy, p.y);
+        }
+    }
+    if (minx === Infinity) {
+        return null;
+    }
+    return { x1: minx, y1: miny, x2: maxx, y2: maxy };
+};
+
+/** Move the glyph so (bx, by) becomes its origin, and divide by scale:
+ *  "save selection as shape" picks a base point and a unit length. */
+CsShapeFont.normalize = function(g, bx, by, unit) {
+    var u = unit && unit > 0 ? unit : 1;
+    var paths = [];
+    for (var i = 0; i < g.paths.length; i++) {
+        var pts = [];
+        for (var k = 0; k < g.paths[i].pts.length; k++) {
+            var p = g.paths[i].pts[k];
+            pts.push([(p.x - bx) / u, (p.y - by) / u, p.b]);
+        }
+        paths.push(CsShapeFont.path(pts, g.paths[i].closed));
+    }
+    return CsShapeFont.glyph(g.name, paths);
+};
+
+CsShapeFont.hex4 = function(n) {
+    var s = n.toString(16).toUpperCase();
+    while (s.length < 4) {
+        s = "0" + s;
+    }
+    return s;
+};
+
+/** The shapes every drawing can use, in unit coordinates. The pattern
+ *  segment's scale sets the real size. */
+CsShapeFont.starters = function() {
+    var P = CsShapeFont.path, L = CsShapeFont.linePath, G = CsShapeFont.glyph;
+    return [
+        G("tick", [L(0, -0.5, 0, 0.5)]),
+        G("tick_up", [L(0, 0, 0, 1)]),
+        G("tick_down", [L(0, 0, 0, -1)]),
+        G("double_tick", [L(-0.2, -0.5, -0.2, 0.5), L(0.2, -0.5, 0.2, 0.5)]),
+        G("chevron", [P([[-0.4, 0.5, 0], [0, 0, 0], [-0.4, -0.5, 0]], false)]),
+        G("arrow", [L(-0.5, 0, 0.5, 0),
+                    P([[0.2, 0.3, 0], [0.5, 0, 0], [0.2, -0.3, 0]], false)]),
+        G("cross", [L(-0.4, -0.4, 0.4, 0.4), L(-0.4, 0.4, 0.4, -0.4)]),
+        G("dot_ring", [CsShapeFont.circlePath(0, 0, 0.25)]),
+        G("scallop", [P([[-0.5, 0, 1], [0.5, 0, 0]], false)])
+    ];
+};
+
+/** CXF text for a list of glyphs. */
+CsShapeFont.write = function(glyphs) {
+    var out = [
+        "# Format:            QCAD 3 Font",
+        "# Creator:           CaveCAD Linetype Maker",
+        "# Name:              " + CsShapeFont.FONT,
+        "# Encoding:          UTF-8",
+        "# LetterSpacing:     3",
+        "# WordSpacing:       6.75",
+        "# LineSpacingFactor: 1",
+        ""
+    ];
+    for (var i = 0; i < glyphs.length; i++) {
+        var g = glyphs[i];
+        out.push("[" + CsShapeFont.hex4(CsShapeFont.CODE_BASE + i) + "] " + g.name);
+        for (var j = 0; j < g.paths.length; j++) {
+            var path = g.paths[j];
+            var parts = [];
+            for (var k = 0; k < path.pts.length; k++) {
+                var p = path.pts[k];
+                parts.push(p.x, p.y, k === path.pts.length - 1 && !path.closed ? 0 : p.b);
+            }
+            out.push((path.closed ? "PLC " : "PL ") + parts.join(","));
+        }
+        out.push("");
+    }
+    return out.join("\n");
+};
+
+/** Glyphs from CXF text (our own output, or a hand-made file using the
+ *  L / A / AR / PL / PLC records). Unnamed glyphs are skipped. */
+CsShapeFont.parse = function(text) {
+    var lines = String(text).split(/\r?\n/);
+    var glyphs = [];
+    var cur = null;
+    var head = /^\[([0-9A-Fa-f]{4})\]\s*(.*)$/;
+    for (var i = 0; i < lines.length; i++) {
+        var line = lines[i].replace(/\s+$/, "");
+        if (line === "" || line.charAt(0) === "#") {
+            continue;
+        }
+        var m = head.exec(line);
+        if (m) {
+            var name = m[2].replace(/^\s+|\s+$/g, "");
+            cur = name.length > 1 ? CsShapeFont.glyph(name, []) : null;
+            if (cur) {
+                glyphs.push(cur);
+            }
+            continue;
+        }
+        if (!cur) {
+            continue;
+        }
+        var sp = line.indexOf(" ");
+        if (sp < 0) {
+            continue;
+        }
+        var code = line.substring(0, sp);
+        var n = line.substring(sp + 1).split(",").map(Number);
+        var bad = n.some(function(v) { return isNaN(v); });
+        if (bad) {
+            continue;
+        }
+        if (code === "L" && n.length === 4) {
+            cur.paths.push(CsShapeFont.linePath(n[0], n[1], n[2], n[3]));
+        } else if ((code === "A" || code === "AR") && n.length === 5) {
+            cur.paths.push(CsShapeFont.arcPath(n[0], n[1], n[2], n[3], n[4], code === "AR"));
+        } else if ((code === "PL" || code === "PLC") && n.length >= 6 && n.length % 3 === 0) {
+            var pts = [];
+            for (var k = 0; k < n.length; k += 3) {
+                pts.push([n[k], n[k + 1], n[k + 2]]);
+            }
+            cur.paths.push(CsShapeFont.path(pts, code === "PLC"));
+        }
+    }
+    return glyphs;
+};
+
+CsShapeFont.indexOf = function(glyphs, name) {
+    for (var i = 0; i < glyphs.length; i++) {
+        if (glyphs[i].name === name) {
+            return i;
+        }
+    }
+    return -1;
+};
+
+/** Replace the glyph of the same name, or append. Returns a new list. */
+CsShapeFont.upsert = function(glyphs, g) {
+    var out = glyphs.slice();
+    var i = CsShapeFont.indexOf(out, g.name);
+    if (i >= 0) {
+        out[i] = g;
+    } else {
+        out.push(g);
+    }
+    return out;
+};
+
+CsShapeFont.remove = function(glyphs, name) {
+    return glyphs.filter(function(g) { return g.name !== name; });
+};
+
+/** Starters first, then personal shapes; a personal shape of the same
+ *  name wins. */
+CsShapeFont.merged = function(personal) {
+    var out = CsShapeFont.starters();
+    for (var i = 0; i < personal.length; i++) {
+        out = CsShapeFont.upsert(out, personal[i]);
+    }
+    return out;
+};
+
+/** The style string a shape segment carries. */
+CsShapeFont.style = function() {
+    return CsShapeFont.FONT + ".shx";
+};
+
+/** Longest chunk of an embedded glyph blob (dxflib's line limit is 1023,
+ *  see LayerGroups.CHUNK for the story). */
+CsShapeFont.CHUNK = 800;
+
+/** One line, no newlines: "name;PL:x,y,b,...;PLC:...|name2;...". */
+CsShapeFont.pack = function(glyphs) {
+    return glyphs.map(function(g) {
+        var parts = [g.name];
+        g.paths.forEach(function(path) {
+            var n = [];
+            path.pts.forEach(function(p) { n.push(p.x, p.y, p.b); });
+            parts.push((path.closed ? "PLC:" : "PL:") + n.join(","));
+        });
+        return parts.join(";");
+    }).join("|");
+};
+
+CsShapeFont.unpack = function(text) {
+    var glyphs = [];
+    if (!text) {
+        return glyphs;
+    }
+    text.split("|").forEach(function(rec) {
+        var f = rec.split(";");
+        if (!CsShapeFont.validName(f[0])) {
+            return;
+        }
+        var g = CsShapeFont.glyph(f[0], []);
+        for (var i = 1; i < f.length; i++) {
+            var closed = f[i].indexOf("PLC:") === 0;
+            var n = f[i].substring(closed ? 4 : 3).split(",").map(Number);
+            if (n.length < 6 || n.length % 3 !== 0 || n.some(isNaN)) {
+                continue;
+            }
+            var pts = [];
+            for (var k = 0; k < n.length; k += 3) {
+                pts.push([n[k], n[k + 1], n[k + 2]]);
+            }
+            g.paths.push(CsShapeFont.path(pts, closed));
+        }
+        glyphs.push(g);
+    });
+    return glyphs;
+};
+
+CsShapeFont.chunks = function(text) {
+    var out = [];
+    for (var i = 0; i < text.length; i += CsShapeFont.CHUNK) {
+        out.push(text.substring(i, i + CsShapeFont.CHUNK));
+    }
+    return out;
+};
+
+/** Names of the shapes a list of linetype models draws. */
+CsShapeFont.usedBy = function(models) {
+    var seen = {};
+    var out = [];
+    models.forEach(function(m) {
+        m.segments.forEach(function(seg) {
+            if (seg.shape && seg.text !== "" && !seen[seg.text]) {
+                seen[seg.text] = true;
+                out.push(seg.text);
+            }
+        });
+    });
+    return out;
+};
diff --git a/cave-survey/scripts/CaveSurvey/Core/CsShapeStore.js b/cave-survey/scripts/CaveSurvey/Core/CsShapeStore.js
new file mode 100644
index 0000000000..aa9c3fb5c4
--- /dev/null
+++ b/cave-survey/scripts/CaveSurvey/Core/CsShapeStore.js
@@ -0,0 +1,281 @@
+// CsShapeStore.js -- the shape library on disk, in the engine, and inside
+// a drawing: the engine half of CsShapeFont.
+//
+// ONE font file, CaveShapes.cxf, holds every shape. The personal copy
+// lives beside the custom linetypes (~/Documents/Cave/linetypes/, which
+// Drive syncs) and is registered with RFontList.addFile so a shape drawn
+// a second ago draws in a linetype now. The glyphs a drawing's shape
+// linetypes use are also embedded in that drawing (document variables,
+// chunked -- see LayerGroups.CHUNK for why) and restored on open, so a
+// cave shared with someone who lacks the shape still renders.
+//
+// Needs: CsShapeFont, CsLinetypeStore (file helpers), the engine.
+
+var CsShapeStore = {};
+
+/** Tests point the library at a scratch folder. */
+CsShapeStore.dirOverride = null;
+
+/** Document variable prefix for the embedded glyph blob. */
+CsShapeStore.VAR = "CaveCADLinetypeShapes";
+
+CsShapeStore.dir = function() {
+    if (CsShapeStore.dirOverride !== null) {
+        return CsShapeStore.dirOverride;
+    }
+    return QDir.homePath() + "/Documents/Cave/linetypes";
+};
+
+CsShapeStore.path = function() {
+    return CsShapeStore.dir() + "/" + CsShapeFont.FONT + ".cxf";
+};
+
+/** The personal glyphs (starters included once written). */
+CsShapeStore.loadPersonal = function() {
+    var text = CsLinetypeStore.readText(CsShapeStore.path());
+    return text === null ? [] : CsShapeFont.parse(text);
+};
+
+/**
+ * Where the engine reads the font from. CaveCAD finds fonts in its own
+ * folders only, so the running copy lives in the user's data folder; the
+ * Drive-synced copy beside the linetypes is the master. Tests point it at
+ * a scratch folder.
+ */
+CsShapeStore.runtimeDirOverride = null;
+
+CsShapeStore.runtimePath = function() {
+    var dir = CsShapeStore.runtimeDirOverride !== null
+        ? CsShapeStore.runtimeDirOverride
+        : String(RSettings.getDataLocation()) + "/fonts";
+    return dir + "/" + CsShapeFont.FONT + ".cxf";
+};
+
+/**
+ * Write the font (starters + the given glyphs) and make the running
+ * engine pick it up: RFontList.init() registers a new font file, and
+ * replaces one whose file changed.
+ * \return null on success, else a sentence.
+ */
+CsShapeStore.publish = function(glyphs) {
+    CsShapeStore.registered = null;
+    var text = CsShapeFont.write(CsShapeFont.merged(glyphs));
+    var err = CsLinetypeStore.writeText(CsShapeStore.path(), text);
+    if (err !== null) {
+        return err;
+    }
+    err = CsLinetypeStore.writeText(CsShapeStore.runtimePath(), text);
+    if (err !== null) {
+        return err;
+    }
+    RFontList.init();
+    var font = RFontList.get(CsShapeFont.FONT);
+    if (isNull(font) || !font.isValid()) {
+        return "CaveCAD could not load the shape font " + CsShapeStore.runtimePath() + ".";
+    }
+    CsShapeStore.registered = CsShapeStore.path();
+    return null;
+};
+
+/** The font file last registered with the engine, or null. */
+CsShapeStore.registered = null;
+
+/** Register what is on disk (before a linetype is applied or previewed);
+ *  a no-op once this session has done it for the current file. */
+CsShapeStore.ensure = function() {
+    if (CsShapeStore.registered === CsShapeStore.path()) {
+        return null;
+    }
+    return CsShapeStore.publish(CsShapeStore.loadPersonal());
+};
+
+/** Add or replace one shape in the personal library. */
+CsShapeStore.save = function(glyph) {
+    var problems = CsShapeFont.validate(glyph);
+    if (problems.length > 0) {
+        return problems.join(" ");
+    }
+    return CsShapeStore.publish(
+        CsShapeFont.upsert(CsShapeStore.loadPersonal(), glyph));
+};
+
+CsShapeStore.remove = function(name) {
+    return CsShapeStore.publish(
+        CsShapeFont.remove(CsShapeStore.loadPersonal(), name));
+};
+
+/** All shapes the library offers: starters, then personal. */
+CsShapeStore.list = function() {
+    return CsShapeFont.merged(CsShapeStore.loadPersonal());
+};
+
+/** True for a type fromEntities can turn into a path. */
+CsShapeStore.isSupported = function(entity) {
+    var t;
+    try { t = entity.getType(); } catch (e) { return false; }
+    return t === RS.EntityLine || t === RS.EntityArc ||
+        t === RS.EntityCircle || t === RS.EntityPolyline;
+};
+
+/** One entity as a CsShapeFont path, or null when unsupported. */
+CsShapeStore.pathOf = function(entity) {
+    if (isNull(entity)) {
+        return null;
+    }
+    var type = entity.getType();
+    var data = entity.getData();
+    if (type === RS.EntityLine) {
+        var s = data.getStartPoint(), e = data.getEndPoint();
+        return CsShapeFont.linePath(s.x, s.y, e.x, e.y);
+    }
+    if (type === RS.EntityArc) {
+        var c = data.getCenter();
+        return CsShapeFont.arcPath(c.x, c.y, data.getRadius(),
+            data.getStartAngle() * 180 / Math.PI,
+            data.getEndAngle() * 180 / Math.PI, data.isReversed());
+    }
+    if (type === RS.EntityCircle) {
+        var cc = data.getCenter();
+        return CsShapeFont.circlePath(cc.x, cc.y, data.getRadius());
+    }
+    if (type === RS.EntityPolyline) {
+        var pts = [];
+        var n = data.countVertices();
+        for (var i = 0; i < n; i++) {
+            var v = data.getVertexAt(i);
+            pts.push([v.x, v.y, data.getBulgeAt(i)]);
+        }
+        return CsShapeFont.path(pts, data.isClosed());
+    }
+    return null;
+};
+
+/**
+ * "Save selection as shape": the selected entities become one glyph,
+ * moved so (base.x, base.y) is the origin and divided by \c unit (the
+ * drawing length that becomes 1, so the pattern's scale means something).
+ * \return { glyph } or { error }
+ */
+CsShapeStore.fromEntities = function(doc, ids, name, base, unit) {
+    var paths = [];
+    var skipped = 0;
+    for (var i = 0; i < ids.length; i++) {
+        var p = CsShapeStore.pathOf(doc.queryEntity(ids[i]));
+        if (p === null) {
+            skipped++;
+        } else {
+            paths.push(p);
+        }
+    }
+    if (paths.length === 0) {
+        return { error: "Select lines, arcs, circles or polylines to make a shape." };
+    }
+    var g = CsShapeFont.normalize(CsShapeFont.glyph(name, paths), base.x, base.y, unit);
+    var problems = CsShapeFont.validate(g);
+    if (problems.length > 0) {
+        return { error: problems.join(" ") };
+    }
+    return { glyph: g, skipped: skipped };
+};
+
+// ---------------------------------------------------------------------
+// Embedding in a drawing
+// ---------------------------------------------------------------------
+
+/** Glyphs embedded in the drawing. */
+CsShapeStore.embedded = function(doc) {
+    var count = parseInt(doc.getVariable(CsShapeStore.VAR + "Count", 0), 10);
+    if (isNaN(count) || count <= 0) {
+        return [];
+    }
+    var text = "";
+    for (var i = 0; i < count; i++) {
+        var c = doc.getVariable(CsShapeStore.VAR + i, "");
+        text += isNull(c) ? "" : String(c);
+    }
+    return CsShapeFont.unpack(text);
+};
+
+/**
+ * Embed the glyphs the given linetype models use. Document variables are
+ * not transactional and carry no modified flag of their own: it is set
+ * here, as LayerGroups does.
+ */
+CsShapeStore.embed = function(doc, models) {
+    var names = CsShapeFont.usedBy(models);
+    var library = CsShapeStore.list();
+    var held = CsShapeStore.embedded(doc);
+    var out = [];
+    names.forEach(function(n) {
+        var i = CsShapeFont.indexOf(library, n);
+        if (i >= 0) {
+            out.push(library[i]);
+        }
+    });
+    // a shape another drawing taught this one stays while it is still used
+    held.forEach(function(g) {
+        if (names.indexOf(g.name) >= 0 && CsShapeFont.indexOf(out, g.name) < 0) {
+            out.push(g);
+        }
+    });
+
+    var previous = parseInt(doc.getVariable(CsShapeStore.VAR + "Count", 0), 10);
+    if (isNaN(previous) || previous < 0) {
+        previous = 0;
+    }
+    var chunks = CsShapeFont.chunks(CsShapeFont.pack(out));
+    for (var i2 = 0; i2 < chunks.length; i2++) {
+        doc.setVariable(CsShapeStore.VAR + i2, chunks[i2]);
+    }
+    for (var j = chunks.length; j < previous; j++) {
+        doc.removeVariable(CsShapeStore.VAR + j);
+    }
+    doc.setVariable(CsShapeStore.VAR + "Count", chunks.length);
+    doc.setModified(true);
+};
+
+/**
+ * On open: make sure every embedded glyph the library lacks is
+ * registered, before the first regeneration draws a shape linetype.
+ * The library's own shape wins a name clash.
+ * \return the names that were restored.
+ */
+CsShapeStore.restore = function(doc) {
+    var personal = CsShapeStore.loadPersonal();
+    var have = CsShapeFont.merged(personal);
+    var restored = [];
+    CsShapeStore.embedded(doc).forEach(function(g) {
+        if (CsShapeFont.indexOf(have, g.name) < 0) {
+            personal = CsShapeFont.upsert(personal, g);
+            restored.push(g.name);
+        }
+    });
+    if (restored.length > 0) {
+        CsShapeStore.publish(personal);
+    }
+    return restored;
+};
+
+/**
+ * On a drawing that came with shapes this machine lacks: register them,
+ * then re-apply the drawing's shaped linetypes so their glyphs are drawn
+ * (the engine built those patterns, empty, when the file was read).
+ * \return the names restored; empty when nothing was missing.
+ */
+CsShapeStore.restoreIfNeeded = function(doc, di) {
+    var restored = CsShapeStore.restore(doc);
+    if (restored.length === 0) {
+        return restored;
+    }
+    var models = CsLinetypeStore.fromDocument(doc);
+    for (var i = 0; i < models.length; i++) {
+        if (CsShapeFont.usedBy([models[i]]).length > 0) {
+            CsLinetypeStore.applyToDocument(doc, di, models[i]);
+        }
+    }
+    try {
+        di.regenerateScenes();
+    } catch (eRegen) {
+    }
+    return restored;
+};
