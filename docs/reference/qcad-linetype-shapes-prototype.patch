+/**
+ * Shaped linetypes against the real engine: a shape written to the
+ * personal font, registered while running, drawn by a linetype, embedded in
+ * the drawing and restored on a machine that lacks it.
+ */
+function fail(msg) {
+    if (typeof restoreRuntime === "function") {
+        restoreRuntime();
+    }
+    print("### SHAPE LINETYPE FAILED: " + msg);
+    QCoreApplication.exit(1);
+    throw msg;
+}
+function check(cond, msg) {
+    if (!cond) {
+        fail(msg);
+    }
+}
+function isNull(v) {
+    return v === null || v === undefined;
+}
+
+var repo = String(args[args.length - 1]);
+function loadRepo(path) {
+    var f = new QFile(repo + "/" + path);
+    check(f.open(QIODevice.ReadOnly | QIODevice.Text), "cannot read " + path);
+    var src = String(new QTextStream(f).readAll());
+    f.close();
+    (0, eval)(src.replace(/^\s*include\(.*\);\s*$/mg, ""));
+}
+loadRepo("scripts/CaveSurvey/Core/CsLinetype.js");
+loadRepo("scripts/CaveSurvey/Core/CsLinetypeStore.js");
+loadRepo("scripts/CaveSurvey/Core/CsShapeFont.js");
+loadRepo("scripts/CaveSurvey/Core/CsShapeStore.js");
+
+var dir = QDir.tempPath() + "/cs_shape_test";
+new QFile(dir + "/CaveShapes.cxf").remove();
+CsShapeStore.dirOverride = dir;
+// The engine only reads fonts from its own folders, so the running copy
+// goes to the real data folder: keep whatever is there and put it back.
+var savedRuntime = CsLinetypeStore.readText(CsShapeStore.runtimePath());
+function restoreRuntime() {
+    if (savedRuntime === null) {
+        new QFile(CsShapeStore.runtimePath()).remove();
+    } else {
+        CsLinetypeStore.writeText(CsShapeStore.runtimePath(), savedRuntime);
+    }
+}
+CsLinetypeStore.pathOverride = dir + "/CaveCustomLinetypes.lin";
+
+function shapeCount(doc, name) {
+    var lt = doc.queryLinetype(name);
+    var pat = lt.getPattern();
+    pat.updateShapes();
+    var n = 0;
+    for (var i = 0; i < pat.getNumDashes(); i++) {
+        if (pat.hasShapeAt(i)) {
+            var paths = pat.getShapeAt(i);
+            if (paths.length > 0 && paths[0].isValid() && !paths[0].isEmpty()) {
+                n++;
+            }
+        }
+    }
+    return n;
+}
+
+// ---- register a starter and a drawn shape while running ---------------
+var ensureErr = CsShapeStore.ensure(); check(ensureErr === null, "ensure: " + ensureErr);
+check(RFontList.get("CaveShapes") !== null && RFontList.get("CaveShapes") !== undefined, "font not registered");
+var mine = CsShapeFont.glyph("zig_test", [CsShapeFont.path([[0, 0, 0], [0.5, 0.5, 0], [1, 0, 0]], false)]);
+check(CsShapeStore.save(mine) === null, "save zig_test");
+check(CsShapeStore.list().some(function(g) { return g.name === "zig_test"; }), "zig_test not listed");
+
+// ---- a linetype that uses them ------------------------------------------
+var doc = new RDocument(new RMemoryStorage(), new RSpatialIndexNavel());
+var di = new RDocumentInterface(doc);
+var r = CsLinetype.fromPattern("A,1,[chevron,CaveShapes.shx,S=0.3],-0.5,[zig_test,CaveShapes.shx,S=0.3],-0.5");
+check(r.errors.length === 0, "pattern parse: " + r.errors.join(";"));
+var m = { name: "CSSHAPE", description: "shape test", segments: r.segments };
+check(CsLinetypeStore.applyToDocument(doc, di, m) === null, "apply shape linetype");
+check(shapeCount(doc, "CSSHAPE") === 2, "engine did not draw both shapes: " + shapeCount(doc, "CSSHAPE"));
+
+// ---- embed, then restore on a library that lacks the shape ---------------
+CsShapeStore.embed(doc, [m]);
+var emb = CsShapeStore.embedded(doc);
+check(emb.length === 2, "embedded " + emb.length + " glyphs, expected 2");
+check(CsShapeStore.remove("zig_test") === null, "remove zig_test");
+check(!CsShapeStore.list().some(function(g) { return g.name === "zig_test"; }), "zig_test still listed");
+var restored = CsShapeStore.restore(doc);
+check(restored.length === 1 && restored[0] === "zig_test", "restore gave " + restored.join(","));
+check(CsShapeStore.list().some(function(g) { return g.name === "zig_test"; }), "zig_test not back");
+
+// ---- save to DXF and reopen: the shapes come back, still shapes -----------
+var dxfPath = QDir.tempPath() + "/cs_shape_rt.dxf";
+check(di.exportFile(dxfPath, "DXF 2000 (*.dxf)", false), "export dxf");
+var doc2 = new RDocument(new RMemoryStorage(), new RSpatialIndexNavel());
+var di2 = new RDocumentInterface(doc2);
+di2.importFile(dxfPath);
+check(shapeCount(doc2, "CSSHAPE") === 2, "reopened drawing draws " + shapeCount(doc2, "CSSHAPE") + " shapes, expected 2");
+var back = CsLinetypeStore.fromDocument(doc2).filter(function(x) { return x.name.toUpperCase() === "CSSHAPE"; })[0];
+check(!isNull(back), "CSSHAPE missing after reopen");
+var shapes = back.segments.filter(function(x) { return x.shape; }).map(function(x) { return x.text; });
+check(shapes.join(",") === "chevron,zig_test", "reopened shape rows: " + shapes.join(","));
+check(CsShapeStore.embedded(doc2).length === 2, "glyphs did not survive the DXF");
+
+restoreRuntime();
+print("### SHAPE LINETYPE OK");
+QCoreApplication.exit(0);
