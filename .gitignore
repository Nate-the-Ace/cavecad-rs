/apps/desktop/src-tauri/gen/apple/Externals/
/apps/desktop/src-tauri/gen/apple/Pods/
/apps/desktop/src-tauri/gen/apple/*.xcworkspace/xcuserdata/
/apps/desktop/src-tauri/gen/apple/*.xcodeproj/xcuserdata/
# the Android project is kept too (hand edits: orientation, Bluetooth permissions); its own .gitignore keeps build output and local.properties out
!/apps/desktop/src-tauri/gen/android/

