# CaveCAD server settings. Copy to .env on the server (mode 600) and fill in.
PORT=8787
HOST=0.0.0.0
DB_PATH=/var/lib/cavecad/cavecad.sqlite
DIST_DIR=/opt/cavecad/web
PASS_KEY_FILE=/var/lib/cavecad/pass-key.json
ADMIN_EMAIL=you@example.com
PUBLIC_URL=https://cavecad.com
# Signs codes and Google sign-in state (at least 32 characters; 32 random bytes, hex). Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_SECRET=
# Google sign-in (optional; without it only emailed codes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Desktop installers + downloads.json (optional)
DOWNLOADS_DIR=/var/lib/cavecad/downloads
# REQUIRED in production: without these emailed sign-in codes are never sent
MAILER_URL=
MAILER_KEY=
# Until there is a public address: reached only through `tailscale serve` on this machine, which sets
# Tailscale-User-Login. Needs HOST=127.0.0.1.
# TAILNET_IDENTITY=1
# Local development only: every request from this machine is this email. PUBLIC_URL must then be a
# localhost address.
# DEV_IDENTITY=you@example.com
