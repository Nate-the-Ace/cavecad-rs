# CaveCAD server settings. Copy to .env on the server (mode 600) and fill in.
PORT=8787
HOST=0.0.0.0
DB_PATH=/var/lib/cavecad/cavecad.sqlite
DIST_DIR=/opt/cavecad/web
PASS_KEY_FILE=/var/lib/cavecad/pass-key.json
ADMIN_EMAIL=you@example.com
PUBLIC_URL=https://cave.schonegg.stream
# The edge server: TinyAuth's Remote-* headers are believed from this address only.
EDGE_ADDRESS=EDGE_VM_ADDRESS
# A long random string, the same value Caddy sets as X-Cave-Gate. Remote-* headers are believed only with it.
GATE_SECRET=
MAILER_URL=
MAILER_KEY=
# TinyAuth's OIDC provider, for the desktop app.
OIDC_ISSUER=https://auth.schonegg.stream
OIDC_CLIENT_ID=cavecad-desktop
OIDC_CLIENT_SECRET=
# Local development only: every request from this machine is this email. Refused beside EDGE_ADDRESS or
# OIDC_ISSUER, and PUBLIC_URL must then be a localhost address.
# DEV_IDENTITY=you@example.com
