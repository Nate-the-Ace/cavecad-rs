{
  "name": "cavecad-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:units": "node --experimental-strip-types tests/units.check.ts",
    "test:spline": "node --experimental-strip-types tests/spline.check.ts",
    "test": "npm run test:units && npm run test:spline && npm run test:glyph && npm run test:editor && npm run test:commands && npm run test:touch && npm run test:relay && npm run test:pen && npm run test:symbols && npm run test:stations && npm run test:zip",
    "test:glyph": "node --experimental-strip-types tests/glyph.check.ts",
    "test:editor": "node --experimental-strip-types tests/lineeditor.check.ts",
    "test:commands": "node --experimental-strip-types tests/commands.check.ts",
    "test:touch": "node --experimental-strip-types tests/touch.check.ts",
    "test:relay": "node tests/relay.check.mjs",
    "test:pen": "node --experimental-strip-types tests/pen.check.ts",
    "test:symbols": "node ../../tools/check_import_symbols.mjs",
    "test:stations": "node --experimental-strip-types tests/stations.check.ts",
    "test:zip": "node --experimental-strip-types tests/zip.check.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "dockview-core": "^8.5.1",
    "html-to-image": "^1.11.11",
    "three": "^0.186.1"
  }
}
