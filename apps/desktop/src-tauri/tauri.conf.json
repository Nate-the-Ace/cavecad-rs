{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaveCAD",
  "version": "0.0.1",
  "identifier": "app.cavecad.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build && node -e \"require('fs').rmSync('../web/dist/local',{recursive:true,force:true})\""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CaveCAD",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cavecad"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNDJBRjNEMzlCODYzQ0UKUldUT1k3ZzVQYTlDRTRGaXM1SDUraTRzN3hRVVh1NWNubkMrZVN4ajNMeGF3U3EwT2RNTUlEZm8K",
      "endpoints": [
        "https://api.cavecad.com/api/desktop-update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
