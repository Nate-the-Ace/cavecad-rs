# CaveCAD on the edge VM. The web app and its API sit behind TinyAuth; the desktop app's API host does not
# (it sends a TinyAuth ID token the server checks itself). Both wipe identity headers a visitor sends, so
# only TinyAuth's answer can say who someone is.
#
# Each site is one `route`, so the directives run in the order written. Without it Caddy's own order runs
# forward_auth before request_header, and the wipe would delete the headers TinyAuth just set (every
# sign-in would get 401). Check with `caddy adapt --pretty`: the delete handler must come first.
#
# CaveCAD has its own TinyAuth (container tinyauth-cave, 127.0.0.1:3001, auth.cavecad.com): a TinyAuth
# session cookie belongs to one domain, and the household sites keep theirs on schonegg.stream.
auth.cavecad.com {
	import hardening
	reverse_proxy 127.0.0.1:3001
}

www.cavecad.com {
	import hardening
	redir https://cavecad.com{uri} 301
}

# The old addresses forward to the new ones.
cave.schonegg.stream {
	import hardening
	redir https://cavecad.com{uri} 301
}

cave-api.schonegg.stream {
	import hardening
	redir https://api.cavecad.com{uri} 308
}

cavecad.com {
	import hardening
	route {
		request_header -Remote-User
		request_header -Remote-Email
		request_header -Remote-Name
		request_header -Remote-Groups
		request_header -Remote-Sub
		request_header -X-Cave-Gate
		forward_auth 127.0.0.1:3001 {
			uri /api/auth/caddy
			copy_headers Remote-User Remote-Email Remote-Name Remote-Groups Remote-Sub
		}
		request_header X-Cave-Gate {env.CAVE_GATE_SECRET}
		reverse_proxy CAVECAD_CT:8787
	}
}

api.cavecad.com {
	import hardening
	route {
		request_header -Remote-User
		request_header -Remote-Email
		request_header -Remote-Name
		request_header -Remote-Groups
		request_header -Remote-Sub
		request_header -X-Cave-Gate
		reverse_proxy CAVECAD_CT:8787
	}
}
